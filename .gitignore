# agent loop driver and all its runtime artifacts (user-local, never part of the repo)
.agent_loop/
export_only_prof_dir/

# NPU/CANN runtime dumps and profiler output (agent-loop process artifacts, never commit)
extra-info/
export_only_prof_dir/
*_prof_dir/
profiling/
exception_info.*
*.o
.tilelang_cache/
benchmarks/probes/h2[79]_perm_*.npy

# vLLM 运行期产物(测试进程内创建)
runtime/
.venv_baseline/
.venv_native213/
.venv_v3/

# pytest 临时缓存目录与本地调试日志（git 权限受限时无法扫描，显式忽略以防误提交）
pytest-cache-files-*/
/debug.log
.venv_ascend/
.venv_ascend30/
trace_out/
/inventory-report.txt

# 统一剖析工具与探针的配置/产物
!scripts/*.json

# 本仓库专属推送凭据(含 PAT,禁止入库)
.git-credentials.local
